{
  "manifest_version": 2,
  "name": "lit-fetch",
  "version": "0.1.9",
  "description": "用 lit-fetch 给条目补 PDF 全文（自动识别 DOI / arXiv / PMID）。",
  "homepage_url": "https://github.com/pengtb/zotero-litfetch",
  "icons": {
    "48": "icon.png",
    "96": "icon@2x.png"
  },
  "applications": {
    "zotero": {
      "id": "litfetch@ptbia.local",
      "update_url": "https://cdn.jsdelivr.net/gh/pengtb/zotero-litfetch@main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
