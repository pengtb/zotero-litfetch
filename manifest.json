{
  "manifest_version": 2,
  "name": "lit-fetch",
  "version": "0.1.0",
  "description": "用 lit-fetch 给条目补 PDF 全文（自动识别 DOI / arXiv / PMID）。",
  "homepage_url": "https://github.com/ptbia/zotero-litfetch",
  "applications": {
    "zotero": {
      "id": "litfetch@ptbia.local",
      "update_url": "https://cdn.jsdelivr.net/gh/ptbia/zotero-litfetch@main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.0.*"
    }
  }
}
